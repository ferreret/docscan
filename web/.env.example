# Copiar a .env y rellenar con valores reales
# Las variables usan prefijo DOCSCAN_WEB_ y separador __ para nested

# Base de datos PostgreSQL
DOCSCAN_WEB_DATABASE__URL=postgresql+psycopg://docscan:docscan@localhost:5432/docscan

# JWT — generar con: openssl rand -hex 32
DOCSCAN_WEB_JWT__SECRET_KEY=your-secret-key-here

# MinIO / S3
DOCSCAN_WEB_MINIO__ACCESS_KEY=docscan
DOCSCAN_WEB_MINIO__SECRET_KEY=docscan123

# Redis
DOCSCAN_WEB_REDIS__URL=redis://localhost:6379/0

# Modo de despliegue: onpremise | cloud
DOCSCAN_WEB_DEPLOY_MODE=onpremise
