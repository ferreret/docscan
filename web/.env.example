# Copiar a .env en la raíz del proyecto y rellenar con valores reales.
#
# Las variables con prefijo DOCSCAN_WEB_ las consume la API (pydantic-settings).
# Las variables POSTGRES_* y MINIO_ROOT_* las consume docker-compose.yml
# (para crear la BD y el bucket de MinIO iniciales).

# --------------------------------------------------------------------
# Modo de ejecución LOCAL (sin docker compose)
# --------------------------------------------------------------------
# Si arrancas uvicorn directamente contra docker-pg o un Postgres local:
DOCSCAN_WEB_DATABASE__URL=postgresql+psycopg://docscan:docscan@localhost:5432/docscan

# Si usas `docker compose up`, comenta la línea anterior y descomenta esta:
# DOCSCAN_WEB_DATABASE__URL=postgresql+psycopg://docscan:docscan@db:5432/docscan

# --------------------------------------------------------------------
# Secreto JWT — OBLIGATORIO
# --------------------------------------------------------------------
# Generar con: openssl rand -hex 32
DOCSCAN_WEB_JWT__SECRET_KEY=replace-me-with-openssl-rand-hex-32

# --------------------------------------------------------------------
# PostgreSQL (usado por el servicio `db` de docker-compose)
# --------------------------------------------------------------------
POSTGRES_USER=docscan
POSTGRES_PASSWORD=docscan
POSTGRES_DB=docscan

# --------------------------------------------------------------------
# MinIO (S3-compatible, listo para migrar storage → MinIO)
# --------------------------------------------------------------------
MINIO_ROOT_USER=docscan
MINIO_ROOT_PASSWORD=docscan123

# La API lee estas con prefijo DOCSCAN_WEB_:
DOCSCAN_WEB_MINIO__ACCESS_KEY=docscan
DOCSCAN_WEB_MINIO__SECRET_KEY=docscan123

# --------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------
DOCSCAN_WEB_REDIS__URL=redis://localhost:6379/0
# En compose, apuntar al servicio interno:
# DOCSCAN_WEB_REDIS__URL=redis://redis:6379/0

# --------------------------------------------------------------------
# General
# --------------------------------------------------------------------
# Modo de despliegue: onpremise | cloud
DOCSCAN_WEB_DEPLOY_MODE=onpremise

# Debug flag (true muestra stack traces completos)
DOCSCAN_WEB_DEBUG=false
