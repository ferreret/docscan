# Copiar a .env en la raíz del proyecto y rellenar TODOS los valores marcados
# como CHANGE_ME con contraseñas fuertes reales antes de arrancar.
#
# Las variables con prefijo DOCSCAN_WEB_ las consume la API (pydantic-settings).
# Las variables POSTGRES_* y MINIO_ROOT_* las consume docker-compose.yml
# (para crear la BD y el bucket de MinIO iniciales).
#
# SEGURIDAD: este fichero NO contiene credenciales reales — son placeholders.
# El fichero .env que copies NUNCA debe committearse (está en .gitignore).

# --------------------------------------------------------------------
# Base de datos PostgreSQL
# --------------------------------------------------------------------
# Usuario de BD (puede mantener valor descriptivo)
POSTGRES_USER=docscan
# Password — OBLIGATORIO cambiar
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Nombre de la BD
POSTGRES_DB=docscan

# URL que usará la API. Para modo LOCAL (uvicorn directo contra Postgres
# en localhost o docker-pg), descomenta la primera:
# DOCSCAN_WEB_DATABASE__URL=postgresql+psycopg://docscan:CHANGE_ME_postgres_password@localhost:5432/docscan
#
# Para modo DOCKER COMPOSE, descomenta la segunda (apunta al servicio interno):
# DOCSCAN_WEB_DATABASE__URL=postgresql+psycopg://docscan:CHANGE_ME_postgres_password@db:5432/docscan
#
# Cuando uses docker compose, esta variable no es estrictamente necesaria
# porque compose la compone desde POSTGRES_* en el servicio `api`.

# --------------------------------------------------------------------
# Secreto JWT — OBLIGATORIO cambiar
# --------------------------------------------------------------------
# Generar un valor real con: openssl rand -hex 32
DOCSCAN_WEB_JWT__SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --------------------------------------------------------------------
# Storage — backend de ficheros de páginas
# --------------------------------------------------------------------
# "filesystem" (disco local, por defecto) o "minio" (S3-compatible)
DOCSCAN_WEB_STORAGE__BACKEND=filesystem
# Solo aplica si backend=filesystem:
# DOCSCAN_WEB_STORAGE__BASE_PATH=/tmp/docscan-storage

# --------------------------------------------------------------------
# MinIO (S3-compatible) — obligatorio si STORAGE__BACKEND=minio
# --------------------------------------------------------------------
MINIO_ROOT_USER=docscan
# Password — OBLIGATORIO cambiar, mínimo 8 caracteres exige MinIO
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars

# La API lee estas mismas credenciales con prefijo DOCSCAN_WEB_ :
DOCSCAN_WEB_MINIO__ACCESS_KEY=docscan
DOCSCAN_WEB_MINIO__SECRET_KEY=CHANGE_ME_minio_password_min_8_chars

# --------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------
# Para modo local:
DOCSCAN_WEB_REDIS__URL=redis://localhost:6379/0
# Para modo compose:
# DOCSCAN_WEB_REDIS__URL=redis://redis:6379/0

# --------------------------------------------------------------------
# General
# --------------------------------------------------------------------
# Modo de despliegue: onpremise | cloud
DOCSCAN_WEB_DEPLOY_MODE=onpremise

# Debug flag (true muestra stack traces completos)
DOCSCAN_WEB_DEBUG=false
