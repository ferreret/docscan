{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${CLAUDE_PROJECT_DIR:-.}"
      ]
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-sqlite",
        "--db-path",
        "${DOCSCAN_DB_PATH:-/home/nicolas/.local/share/docscan/docscan.db}"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/mcp-postgres.sh"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}
